# Offline hardware validation image. The production Dockerfile reuses its
# validated server and media runtime without the test executables.
FROM golang:1.27-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN test -z "$(gofmt -l .)" && go test ./... && go vet ./...
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/go-vod .
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="-s -w" -o /out/rkmpp-smoke ./cmd/rkmpp-smoke
RUN CGO_ENABLED=0 go test -c -o /out/ffmpeg.test ./ffmpeg && \
    CGO_ENABLED=0 go test -c -o /out/core.test ./core && \
    CGO_ENABLED=0 go test -c -o /out/api.test ./api

# Preserve the pinned multimedia stack's MPP ABI. Only backport the optional
# VP8 control callback semantics; a wholesale SDK replacement changes the ABI.
FROM golang:1.27-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS mpp
RUN apt-get update && apt-get install -y --no-install-recommends cmake libdrm-dev && rm -rf /var/lib/apt/lists/*
ARG MPP_COMMIT=a9380ef333102ac318628f83b5f7a460d377749e
WORKDIR /src
RUN git init && git fetch --depth 1 https://github.com/nyanmisaka/mpp.git ${MPP_COMMIT} && git checkout --detach FETCH_HEAD
COPY patches/mpp-vp8-optional-control.patch /tmp/mpp-vp8.patch
RUN git apply --check /tmp/mpp-vp8.patch && git apply /tmp/mpp-vp8.patch
RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON -DBUILD_TEST=OFF -DRKPLATFORM=ON -DHAVE_DRM=ON -DCMAKE_INSTALL_PREFIX=/out && cmake --build build --parallel 4 && cmake --install build

# Use the SAME pinned multimedia base image as the previously verified
# Memories 10.2 / go-vod 0.6.3 R7 RK3588 Dockerfile.
FROM jellyfin/jellyfin@sha256:fea863d0cd9ec445985d9c75fc6ed64e38a1d2766cf0c250a33d553f4fc1b771 AS media
RUN set -eu; \
    mkdir -p /rootfs/usr/lib/jellyfin-ffmpeg /rootfs/usr/local/bin /rootfs/etc/OpenCL/vendors /rootfs/tmp /rootfs/cache/tmp /rootfs/app; \
    for bin in /usr/lib/jellyfin-ffmpeg/ffmpeg /usr/lib/jellyfin-ffmpeg/ffprobe /usr/lib/aarch64-linux-gnu/libmali.so.1; do \
      cp -L --parents "$bin" /rootfs; \
      LD_PRELOAD= ldd "$bin"; \
    done | awk '/=> \// {print $3} /^[[:space:]]*\// {print $1}' | sort -u > /tmp/runtime-libraries; \
    while IFS= read -r lib; do cp -L --parents "$lib" /rootfs; done < /tmp/runtime-libraries; \
    ln -s /usr/lib/jellyfin-ffmpeg/ffmpeg /rootfs/usr/local/bin/ffmpeg; \
    ln -s /usr/lib/jellyfin-ffmpeg/ffprobe /rootfs/usr/local/bin/ffprobe; \
    printf '/usr/lib/aarch64-linux-gnu/libmali.so.1\n' > /rootfs/etc/OpenCL/vendors/mali.icd; \
    cp -L --parents /etc/ssl/certs/ca-certificates.crt /rootfs; \
    printf 'transcoder:x:1000:1000:Video transcoder:/tmp:/nonexistent\n' > /rootfs/etc/passwd; \
    printf 'transcoder:x:1000:\n' > /rootfs/etc/group; \
    printf 'hosts: files dns\n' > /rootfs/etc/nsswitch.conf; \
    chmod 1777 /rootfs/tmp; \
    chown -R 1000:1000 /rootfs/cache

FROM scratch
COPY --from=media /rootfs/ /
COPY --from=mpp /out/lib/librockchip_mpp.so.0 /usr/lib/jellyfin-ffmpeg/lib/librockchip_mpp.so.1
COPY --from=mpp /src/LICENSES/ /usr/share/licenses/rockchip-mpp/
COPY --from=build /out/go-vod /app/go-vod
COPY --from=build /out/rkmpp-smoke /app/rkmpp-smoke
COPY --from=build /out/ffmpeg.test /out/core.test /out/api.test /app/
COPY LICENSE /usr/share/licenses/go-vod/LICENSE
ENV PATH=/usr/local/bin:/app \
    LD_LIBRARY_PATH=/usr/lib/jellyfin-ffmpeg/lib \
    MEMORIES_RKMPP=1 \
    MEMORIES_RKMPP_CODEC=hevc \
    MEMORIES_RKMPP_OPENCL=false \
    CACHE_DIR=/cache \
    TMPDIR=/cache/tmp \
    HOME=/tmp
USER 1000:1000
WORKDIR /app
# Intentionally no exposed port/healthcheck: offline hardware test only.
ENTRYPOINT ["/app/rkmpp-smoke"]
LABEL org.opencontainers.image.version="memories-11.0.2-govod-0.7.0-rkmpp-hardware-smoke" \
      cc.memories-rkmpp.stage="offline-test-only"
