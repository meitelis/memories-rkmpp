+	s.Bin = filepath.Join(dir, "ffmpeg")
+	require.NoError(t, os.WriteFile(s.Bin, []byte("#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$PROBE_ARGS\"\n"), 0755))
