+		videoRate := max(128000, s.Bitrate*9/10-audioRate)
+		args = append(args, "-rc_mode", "VBR", "-b:v", strconv.Itoa(videoRate),
+			"-maxrate", strconv.Itoa(videoRate), "-bufsize", strconv.Itoa(videoRate*2),
+			"-qp_init", strconv.Itoa(qp))
+	} else {
+		args = append(args, "-rc_mode", "CQP", "-qp_init", strconv.Itoa(qp))
+	}
+	if s.Audio.CodecName != "" && !s.SeparateAudio {
+		args = append(args, "-map", "0:a:0?")
+		if copyRKMPPAudio(s.Audio) {
+			args = append(args, "-c:a", "copy")
+			if s.HLS && s.StartAt > 0 {
+				args = append(args, "-copypriorss:a", "0")
+			}
+		} else {
+			af := "aresample=async=1"
+			if s.HLS && s.StartAt > 0 {
+				af = fmt.Sprintf("atrim=start=%.6f,", s.StartAt) + af
+			}
+			args = append(args, "-c:a", "aac", "-ac", "2", "-ar", "48000", "-b:a", "128k", "-af", af)
+		}
+	} else {
+		args = append(args, "-an")
+	}
+	return args
+}
+
+// setparams changes metadata only; it keeps the imported OpenCL surfaces on
+// the GPU. Do not invent PQ/HLG tags when the source does not identify them.
+func rkmppSourceColor(s Spec) []string {
+	var tags []string
+	for _, field := range []struct{ key, value string }{
+		{"color_trc", s.ColorTransfer}, {"color_primaries", s.ColorPrimaries},
+		{"colorspace", s.ColorSpace}, {"range", s.ColorRange},
+	} {
+		if field.value != "" && field.value != "unknown" && field.value != "unspecified" {
+			tags = append(tags, field.key+"="+field.value)
+		}
+	}
+	if len(tags) == 0 {
+		return nil
+	}
+	return []string{"setparams=" + strings.Join(tags, ":")}
+}
diff --git a/go-vod/ffmpeg/rkmpp_bandwidth_test.go b/go-vod/ffmpeg/rkmpp_bandwidth_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..18665bf13c0c045b0588b678de1832c525eba656
--- /dev/null
+++ b/go-vod/ffmpeg/rkmpp_bandwidth_test.go
@@ -0,0 +1,54 @@
+package ffmpeg
+
+import "testing"
+
+// TestRKMPPMinBitrateCoversAudio checks that RKMPPMinBitrate accounts for
+// the audio track overhead, so low-resolution renditions are still advertised
+// with enough bandwidth to include both the video floor and the audio.
+func TestRKMPPMinBitrateCoversAudio(t *testing.T) {
+	for _, tc := range []struct {
+		name    string
+		audio   AudioInfo
+		wantMin int // must be strictly above audio-only
+	}{
+		{
+			name:    "no audio",
+			audio:   AudioInfo{},
+			wantMin: 128000, // just video floor * headroom
+		},
+		{
+			name:    "copyable AAC-LC 128k",
+			audio:   AudioInfo{CodecName: "aac", Profile: "LC", Channels: 2, SampleRate: 48000, BitRate: 128000},
+			wantMin: 128000 + 128000, // video floor + audio
+		},
+		{
+			name:    "normalized multi-channel (128k encoded)",
+			audio:   AudioInfo{CodecName: "eac3", Channels: 6, SampleRate: 48000, BitRate: 384000},
+			wantMin: 128000 + 128000, // video floor + 128k normalized
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got := RKMPPMinBitrate(tc.audio)
+			// The formula is ((128k + audioBitrate) * 10 + 8) / 9.
+			// At minimum both terms must be represented.
+			audioPart := rkmppAudioBitrate(tc.audio)
+			plain := 128000 + audioPart
+			if got <= 0 {
+				t.Errorf("RKMPPMinBitrate(%+v) = %d, want > 0", tc.audio, got)
+			}
+			// The result must be >= the plain sum (10/9 mux headroom applied).
+			if got < plain {
+				t.Errorf("RKMPPMinBitrate(%+v) = %d, want >= %d", tc.audio, got, plain)
+			}
+		})
+	}
+}
+
+// TestRKMPPMinBitrateIsStableForSilent ensures silent videos don't panic
+// and return a sensible positive floor.
+func TestRKMPPMinBitrateIsStableForSilent(t *testing.T) {
+	got := RKMPPMinBitrate(AudioInfo{})
+	if got <= 0 {
+		t.Errorf("RKMPPMinBitrate(silent) = %d, want > 0", got)
+	}
+}
diff --git a/go-vod/ffmpeg/rkmpp_grid_hardware_test.go b/go-vod/ffmpeg/rkmpp_grid_hardware_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..4bbd5051500bb962f329587a86aedf9ce99ea5e9
--- /dev/null
+++ b/go-vod/ffmpeg/rkmpp_grid_hardware_test.go
@@ -0,0 +1,76 @@
+package ffmpeg
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+// Fractional, irregular Original GOPs must survive RGA resizing, VBR encoding
+// and cold restarts. Each fragment must decode using the original cached init.
+func TestRKMPPHardwareSourceGrid(t *testing.T) {
+	if os.Getenv("MEMORIES_RKMPP_HW_TEST") != "1" {
+		t.Skip("set MEMORIES_RKMPP_HW_TEST=1 on RK3588 with MPP/RGA devices")
+	}
+	bin, err := exec.LookPath("ffmpeg")
+	require.NoError(t, err)
+	probe, err := exec.LookPath("ffprobe")
+	require.NoError(t, err)
+	dir := t.TempDir()
+	src := filepath.Join(dir, "irregular.mp4")
+	out, err := exec.Command(bin, "-v", "error", "-f", "lavfi", "-i", "testsrc2=s=640x360:r=30000/1001",
+		"-t", "11.011", "-c:v", "libx264", "-threads", "2", "-bf", "0", "-g", "1000", "-sc_threshold", "0",
+		"-force_key_frames", "0,0.93,2.93,6.93,9.40", src).CombinedOutput()
+	require.NoError(t, err, string(out))
+	info, err := Probe(context.Background(), probe, src, "")
+	require.NoError(t, err)
+	keys, err := Keyframes(context.Background(), probe, src, "")
+	require.NoError(t, err)
+	grid := NewRKMPPKeyframeGrid(CopySegments(keys, info.Duration), info.FrameRate)
+	require.NotNil(t, grid)
+	require.Len(t, grid.Segments, 5)
+	for _, codec := range []string{"h264", "hevc"} {
+		for _, size := range []struct{ w, h int }{{640, 360}, {320, 180}} {
+			t.Run(fmt.Sprintf("%s-%d", codec, size.w), func(t *testing.T) {
+				var initial []byte
+				for _, startID := range []int{0, 2} {
+					run := t.TempDir()
+					s := Spec{Bin: bin, Input: src, RKMPP: true, RKMPPOutputCodec: codec,
+						CodecName: info.CodecName, PixelFormat: info.PixelFormat, BitDepth: info.BitDepth,
+						FrameRate: info.FrameRate, FrameRateExact: info.FrameRateExact,
+						Width: size.w, Height: size.h, QF: 24, Bitrate: 1300000, HLS: true, ChunkSize: 3,
+						StartAt: grid.Segments[startID].Start, KeyframeGrid: grid}
+					require.True(t, usesRKMPPFrames(s))
+					init := filepath.Join(run, "init.mp4")
+					out, err := exec.Command(bin, SegmentArgs(s, startID, filepath.Join(run, "video-%06d.m4s"), init)...).CombinedOutput()
+					require.NoError(t, err, string(out))
+					header, err := os.ReadFile(init)
+					require.NoError(t, err)
+					if startID == 0 {
+						initial = header
+					} else {
+						require.Equal(t, initial, header, "cold start must preserve the cached init")
+					}
+					files, err := filepath.Glob(filepath.Join(run, "video-*.m4s"))
+					require.NoError(t, err)
+					require.Len(t, files, len(grid.Segments)-startID, "no extra periodic/scene IDRs")
+					for id := startID; id < len(grid.Segments); id++ {
+						segment, err := os.ReadFile(filepath.Join(run, fmt.Sprintf("video-%06d.m4s", id)))
+						require.NoError(t, err)
+						joined := filepath.Join(run, "joined.mp4")
+						require.NoError(t, os.WriteFile(joined, append(append([]byte{}, initial...), segment...), 0644))
+						out, err := exec.Command(bin, "-v", "error", "-xerror", "-i", joined, "-f", "null", "-").CombinedOutput()
+						require.NoError(t, err, string(out))
+						seg := grid.Segments[id]
+						assertPacketGrid(t, probe, joined, seg.Start, seg.Duration)
+					}
+				}
+			})
+		}
+	}
+}
diff --git a/go-vod/ffmpeg/rkmpp_hardware_test.go b/go-vod/ffmpeg/rkmpp_hardware_test.go
